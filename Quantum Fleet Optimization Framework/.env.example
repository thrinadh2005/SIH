# =====================================================================
# GreenFleet Quantum (SIH-26138) -- Environment Configuration Template
# Copy this file to .env and fill in your credentials
# NEVER commit .env to Git -- it is already in .gitignore
# =====================================================================

# --- APP SERVER ---
PORT=8000
HOST=0.0.0.0
WORKERS=4
DEBUG=false

# --- DATABASE ---
DATABASE_URL=sqlite:///data/greenfleet.db

# --- IBM QUANTUM PLATFORM ---
# Get FREE at: https://quantum.ibm.com -> Profile -> Copy API Token
IBM_QUANTUM_API_TOKEN=
IBM_QUANTUM_CHANNEL=ibm_quantum_platform
IBM_QUANTUM_BACKEND=ibm_heron_156q

# --- COPERNICUS MARINE (Ocean Currents) ---
# Get FREE at: https://data.marine.copernicus.eu -> Register
COPERNICUS_USERNAME=
COPERNICUS_PASSWORD=

# --- AISSTREAM (Live Vessel AIS Tracking) ---
# Get FREE at: https://aisstream.io -> Sign Up -> Dashboard
AISSTREAM_API_KEY=

# --- WEATHER (OpenMeteo) ---
# No API key required -- completely free and open!
OPENMETEO_BASE_URL=https://api.open-meteo.com/v1

# --- OPTIONAL AIS (AISHub fallback) ---
AISHUB_USERNAME=
AISHUB_API_KEY=

# --- SECURITY ---
JWT_SECRET_KEY=change_me_to_random_64_char_hex_string_in_production
