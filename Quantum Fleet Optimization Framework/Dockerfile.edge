# GreenFleet Quantum - Shipboard Offline-First Edge Container
FROM python:3.11-slim

WORKDIR /app

# Install minimal edge dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    sqlite3 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY core/ ./core/
COPY ml/ ./ml/
COPY backend/ ./backend/
COPY data/ ./data/

ENV PYTHONPATH=/app
ENV EDGE_AUTONOMOUS_MODE=true

EXPOSE 8080

CMD ["python", "backend/edge_daemon.py"]
